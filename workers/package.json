{
  "name": "mangadock-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm run check && npm test && npm run test:e2e && npm run test:migration && node --test test/d1-budget.mjs test/workflows.test.mjs && npm run test:database",
    "test:database": "node --experimental-strip-types --test test/database*.mjs test/update-diagnostics.mjs",
    "database:init": "node --experimental-strip-types scripts/turso-migrate.mjs",
    "deploy:staging": "npm run build && node scripts/bootstrap.mjs staging",
    "deploy:production": "npm run build && node scripts/bootstrap.mjs production",
    "bootstrap": "node scripts/bootstrap.mjs",
    "source:register": "node scripts/register-source.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "test:migration": "python3 -m unittest discover -s test -p \"*_test.py\" && python3 -m unittest discover -s ../tools/cf -p \"test_*.py\""
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.10.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@playwright/test": "1.64.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20251011.1",
    "nunjucks": "^3.2.4",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vitest": "~3.2.0",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@noble/hashes": "^2.0.1",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "lz-string": "^1.5.0"
  }
}
