.git
.gitignore
.github/
**/__pycache__/
**/*.py[cod]
**/._*
.DS_Store
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.env
.env.*

# Never bake personal libraries, covers, databases, sessions, logs, or locks
# into a public image. docker-compose mounts these directories at runtime.
data/
comic/
小说/
instance/
static/cover/*
!static/cover/cover.png

node_modules/
tests/
old/
scripts/
# tools/ 只放行封面超分链路（worker + ONNX 模型 + 批量工具），
# 其余开发脚本不进镜像。git 里仍完整保留 tools/。
tools/*
!tools/cover_sr_worker.py
!tools/refresh_hero_covers.py
!tools/models
!tools/models/*.onnx

# The private Fanqie implementation is deployed separately and must never be
# copied into a public source package or image build context.
**/fanqie_download.py
**/fanqie_download.pyc
mangadock/vendor/
private/
fanqie-api/
github-mangadock/
dockerhub-src/
*.db
*.sqlite
*.sqlite3
*.log
*.lock
*.before-*
*.epub
*.pdf
*.cbz
